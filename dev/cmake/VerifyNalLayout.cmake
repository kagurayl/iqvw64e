file(READ "${MAP_FILE}" _map)
string(REGEX MATCH "[ \t]nal_data[ \t]+([0-9A-Fa-f]+)[ \t]" _prefix "${_map}")
if(NOT _prefix)
    message(FATAL_ERROR "nal_data was not found in ${MAP_FILE}")
endif()
set(_prefix_address "0x${CMAKE_MATCH_1}")
string(REGEX MATCH "[ \t]nal_data_tail[ \t]+([0-9A-Fa-f]+)[ \t]" _tail "${_map}")
if(NOT _tail)
    message(FATAL_ERROR "nal_data_tail was not found in ${MAP_FILE}")
endif()
math(EXPR _distance "0x${CMAKE_MATCH_1} - ${_prefix_address}")
if(NOT _distance EQUAL 512)
    message(FATAL_ERROR "Global storage is not contiguous: expected 512, got ${_distance}")
endif()
file(SIZE "${DRIVER_FILE}" _bytes)
message(STATUS "Global data layout verified; ${DRIVER_FILE}: ${_bytes} bytes")
