<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata minClientVersion="2.5">
    <id>Musa.CoreLite</id>
    <version>1.2.2</version>
    <title>Musa.CoreLite</title>
    <authors>MeeSong</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>build\native\README.md</readme>
    <projectUrl>https://github.com/MiroKaku/Musa.CoreLite</projectUrl>
    <description>Musa.CoreLite - 该项目旨在解决 Zw* 系统例程导出符号不完整的问题，使开发者能够在用户模式和内核模式下直接调用所有 Zw* 系统例程而无需担心符号缺失的问题。</description>
    <releaseNotes>v1.2.2: bump Musa.Veil to 1.10.0</releaseNotes>
    <copyright>Copyright© MeeSong</copyright>
    <tags>Musa.CoreLite Native WDK KMDF Kernel Driver</tags>
    <repository type="git" url="https://github.com/MiroKaku/Musa.CoreLite.git" branch="main" commit="a1fa9fa79131cf0c19e1b32bc3ba10be93387157" />
    <dependencies>
      <dependency id="Musa.Veil" version="1.10.0" />
    </dependencies>
  </metadata>
</package>